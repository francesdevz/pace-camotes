# Copy these into Vercel → Project → Settings → Environment Variables.

# Supabase → Project Settings → API
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_SERVICE_ROLE_KEY=paste-the-service_role-secret-key

# Password for /admin (choose a long one)
ADMIN_PASSWORD=change-me-to-something-long
# Random string of 32+ characters that signs admin sessions
ADMIN_SESSION_SECRET=paste-a-long-random-string-here

# Optional club settings
# COURTS=2
# BOOKING_TIMES=06:00,07:00,08:00,09:00,10:00,15:00,16:00,17:00,18:00,19:00,20:00,21:00
# BOOKING_DAYS=14
# MAX_ACTIVE_PER_CONTACT=3
